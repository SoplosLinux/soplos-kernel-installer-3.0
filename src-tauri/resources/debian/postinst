#!/bin/sh
# When the package is installed or updated, the sources of the NVIDIA driver
# are left patched, as the program does when it installs a kernel. The kernels
# that arrive later from a terminal then build the module with no help.
# It never makes the installation fail.
set -e

if [ "$1" = "configure" ]; then
    /usr/bin/soplos-kernel-installer --patch-nvidia || true

    # The hook that downloads the latest patches of the nvidia-patches project and
    # applies them before DKMS builds the module, when a kernel or its headers are
    # installed. Its name sorts before "dkms" on purpose. It is only installed on
    # a computer that has an NVIDIA graphics card (the card, not the driver, so it
    # is already there when the driver is installed later); on any other computer
    # nothing of it is left in /etc, and what an earlier install left is removed.
    HOOK=/usr/lib/soplos-kernel-installer/00-soplos-nvidia-patches
    if lspci 2>/dev/null | grep -i -E 'vga|display|3d controller' | grep -qi nvidia; then
        if [ -f "$HOOK" ]; then
            for dir in /etc/kernel/postinst.d /etc/kernel/header_postinst.d; do
                mkdir -p "$dir"
                install -m 755 "$HOOK" "$dir/00-soplos-nvidia-patches" || true
            done
            "$HOOK" || true
        fi
    else
        rm -f /etc/kernel/postinst.d/00-soplos-nvidia-patches \
              /etc/kernel/header_postinst.d/00-soplos-nvidia-patches
        rm -rf /var/lib/soplos-nvidia-patches
        rm -f /var/log/soplos-nvidia-patches.log
    fi
fi

exit 0
